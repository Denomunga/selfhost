# Copy this file to .env and fill in real values before starting the server.

# MongoDB connection string.
# Local MongoDB example:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=rift_motors

# Long random secret used to sign session tokens. Generate one with:
#   openssl rand -hex 32
# The server refuses to start if this is missing or still the placeholder.
JWT_SECRET=replace-this-with-a-long-random-value

PORT=4000

# Where uploaded vehicle/part photos are stored on disk.
UPLOAD_DIR=./uploads

# Set to "true" once you're serving over HTTPS in production, so the
# session cookie is only ever sent over an encrypted connection.
COOKIE_SECURE=false

# Set to 1 when the app runs behind a reverse proxy (nginx, Caddy, a
# hosting load balancer) so login rate limiting and logs see real client
# IPs instead of the proxy's. Leave unset when the app is reached directly.
# TRUST_PROXY=1

# Only needed if you serve the frontend from a different origin than
# this API (the split deployment: frontend on Vercel, API on Render).
# Comma-separate several origins. Leave unset when the server also serves
# web/ directly (the default) — same-origin requests need no CORS.
# CORS_ORIGIN=https://your-app.vercel.app

# "none" only for the split deployment, where the frontend is a different
# site and the session cookie must travel cross-site. Browsers require
# Secure on SameSite=None cookies, so COOKIE_SECURE=true is mandatory with
# this — the server refuses to start otherwise. Leave unset (Lax) when the
# frontend is served by this same app.
# COOKIE_SAMESITE=none

# Uploaded photos go to Cloudflare R2 (S3-compatible) when these are set —
# required on Render, which has no persistent disk. Leave unset to keep
# photos on local disk at UPLOAD_DIR.
# R2_ACCOUNT_ID=your-r2-account-id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=rift-motors-uploads
